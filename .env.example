# OpenRouter (https://openrouter.ai) — the sole LLM provider.
# All model calls (agent + vision tier) go through OpenRouter.
# Sign up at openrouter.ai/keys to get your API key.
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Anthropic — alternative provider (Claude Sonnet 4).
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Optional explicit model override. Leave blank to use the default
# (openrouter/google/gemini-3.7-flash).
# Run `python -m orbit.run_task --list-models` to see known-good options.
ORBIT_MODEL=
