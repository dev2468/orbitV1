# NVIDIA NIM (build.nvidia.com) — current primary provider.
# Free tier available to NVIDIA Developer Program members, ~40 req/min.
NVIDIA_NIM_API_KEY=your-nvidia-nim-api-key-here

# Optional fallbacks.
DEEPSEEK_API_KEY=your-deepseek-api-key-here
GROQ_API_KEY=your-groq-api-key-here

# Optional explicit model override. Leave blank to use the default
# (nvidia_nim/nvidia/nemotron-3.5-lightning-30b-a3b).
# Run `python -m orbit.run_task --list-models` to see known-good options.
ORBIT_MODEL=
